# Copy this file to .env and fill in real values. Never commit .env.

APP_NAME=ECHO
LOG_LEVEL=INFO

# LLM (any OpenAI-compatible provider; switch provider by changing these three)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-120b

# Embeddings (OpenAI-compatible endpoint)
EMBEDDING_BASE_URL=https://api.jina.ai/v1/
EMBEDDING_API_KEY=your-jina-api-key
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIMENSIONS=768

# Speech (Deepgram: streaming speech-to-text and text-to-speech)
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Vector store (Qdrant Cloud free cluster)
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Local database for topics, meetings and board items
DATABASE_URL=sqlite+aiosqlite:///./echo.db
