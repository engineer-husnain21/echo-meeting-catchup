# Copy this file to .env and fill in real values. Never commit .env.

APP_NAME=ECHO
LOG_LEVEL=INFO

# LLM (any OpenAI-compatible provider; switch provider by changing these three)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key
LLM_MODEL=openai/gpt-oss-120b

# Embeddings (OpenAI-compatible endpoint)
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
# Optional provider task hints (Jina uses them; leave empty for other providers)
EMBEDDING_PASSAGE_TASK=retrieval.passage
EMBEDDING_QUERY_TASK=retrieval.query
EMBEDDING_BATCH_SIZE=32

# Speech (Deepgram: streaming speech-to-text and text-to-speech)
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Vector store (Qdrant Cloud free cluster)
# Keep the :443 at the end: many office/home networks block Qdrant's default port 6333.
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io:443
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=echo_chunks
QDRANT_TIMEOUT_SECONDS=30

# Local database for topics, meetings and board items
DATABASE_URL=sqlite+aiosqlite:///./echo.db

# Uploads
MAX_UPLOAD_MB=20
CHUNK_LINES=6
CHUNK_OVERLAP_LINES=2
